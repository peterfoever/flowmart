# 生产环境变量模板。
#
# 使用方式：cp .env.example .env && vim .env
# ⚠️ .env 已在 .gitignore 里，绝对不要提交真实密码到 git ——
#    密码一旦进了 git 历史就等于泄露，即使后来删掉，历史提交里仍然能检出来。
#
# 真实公司里这些值来自配置中心（Nacos/Apollo）或密钥管理服务（Vault/KMS），
# 不会以文件形式落在服务器上。这里用 .env 是训练环境的简化。

# 发布版本，必须是 release tag，禁止 latest
IMAGE_TAG=v1.0.0

# 数据库
DB_HOST=
DB_PORT=3306
DB_NAME=flowmart
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.flowmart.product.mapper.ProductCategoryMapper">

    <!-- ========== ResultMap：字段映射 ========== -->
    <resultMap id="BaseResultMap" type="com.flowmart.product.entity.ProductCategory">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="icon_url" property="iconUrl"/>
        <result column="level" property="level"/>
        <result column="sort_no" property="sortNo"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>

    <!-- ========== 通用字段列表 ========== -->
    <sql id="BaseColumns">
        id, parent_id, name, icon_url, level, sort_no, status,
        created_by, created_at, updated_by, updated_at, deleted, version
    </sql>




    <!-- ========== ✅ 自定义方法1：检查同级是否存在同名类目 ========== -->
    <select id="existsByNameAndParent" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM product_category
        WHERE parent_id = #{parentId}
        AND name = #{name}
        AND deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- ========== ✅ 自定义方法2：根据父 ID 查询子类目列表 ========== -->
    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM product_category
        WHERE parent_id = #{parentId}
        AND deleted = 0
        ORDER BY sort_no ASC, id ASC
    </select>

    <!-- 查询所有未删除类目，按 sort_no ASC, id ASC 排序 -->
    <select id="selectAllUndeletedOrdered" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM product_category
        WHERE deleted = 0
        ORDER BY sort_no ASC, id ASC
    </select>

    <!-- 递归查询类目下的所有子类目 -->
    <select id="selectSubtree" resultMap="BaseResultMap">
        WITH RECURSIVE category_tree AS (
            SELECT id, parent_id, level, name
            FROM product_category
            WHERE id = #{rootId} AND deleted = 0

            UNION ALL

            SELECT c.id, c.parent_id, c.level, c.name
            FROM product_category c
                     JOIN category_tree t ON c.parent_id = t.id
            WHERE c.deleted = 0
        )
        SELECT id, parent_id, level, name
        FROM category_tree;
    </select>
    <update id="batchLogicDelete">
        UPDATE product_category
        SET deleted = UNIX_TIMESTAMP(),
        updated_at = NOW(),
        updated_by = #{updatedBy}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
    </update>

    <!-- ============================================================ -->
    <!-- ========== 方法2: 批量更新父类目 ID（子类目上提） ========== -->
    <!-- ============================================================ -->

    <update id="batchUpdateParentId">
        UPDATE product_category
        SET parent_id = #{targetParentId},
        updated_at = NOW(),
        updated_by = #{updatedBy}
        WHERE id IN
        <foreach collection="childIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
    </update>

    <!-- ============================================================ -->
    <!-- ========== 方法3: 批量层级减 1 ========== -->
    <!-- ============================================================ -->

    <update id="batchDecreaseLevel">
        UPDATE product_category
        SET level = level - 1,
        updated_at = NOW(),
        updated_by = #{updatedBy}
        WHERE id IN
        <foreach collection="descendantIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
    </update>
</mapper>
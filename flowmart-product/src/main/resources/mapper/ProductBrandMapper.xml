<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowmart.product.mapper.ProductBrandMapper">
    <!-- ========== ResultMap：字段映射 ========== -->
    <resultMap id="BaseResultMap" type="com.flowmart.product.entity.ProductBrand">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="logo_url" property="logoUrl"/>
        <result column="initial" property="initial"/>
        <result column="sort_no" property="sortNo"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>
    <!-- ========== 通用字段 ========== -->
    <sql id="BaseColumns">
        id, name, logo_url, initial, sort_no, status,
        created_by, created_at, updated_by, updated_at, deleted, version
    </sql>

    <!-- ========== 通用查询条件 ========== -->
    <sql id="QueryCondition">
        <where>
            deleted = 0
            <if test="query.name != null and query.name != ''">
                AND name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.initial != null and query.initial != ''">
                AND initial = #{query.initial}
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
    </sql>


    <!-- 检查品牌名称是否已存在 -->
    <select id="existsByNameAndDeleted" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM product_brand
        WHERE name = #{name}
        AND deleted = #{deleted}
    </select>

    <!-- 修改名称时必须排除当前品牌；禁用品牌同样占用名称。 -->
    <select id="existsByNameExcludingId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM product_brand
        WHERE name = #{name}
          AND deleted = 0
          AND id &lt;&gt; #{excludeId}
    </select>
    <select id="countByQuery" resultType="long">
        SELECT COUNT(*) FROM product_brand
        <include refid="QueryCondition"/>
    </select>

    <select id="selectBrandPage" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM product_brand
        <include refid="QueryCondition"/>
        ORDER BY sort_no ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 逻辑删除类目下所有未删除的绑定 -->
    <update id="logicDeleteByCategoryId">
        UPDATE product_category_brand
        SET deleted = id,
            updated_by = #{updatedBy},
            updated_at = NOW()
        WHERE category_id = #{categoryId}
          AND deleted = 0
    </update>

    <!-- 批量插入绑定 -->
    <insert id="batchInsert">
        INSERT INTO product_category_brand (
        id, category_id, brand_id,
        created_by, created_at, updated_by, updated_at, deleted
        ) VALUES
        <foreach collection="bindings" item="binding" separator=",">
            (
            #{binding.id}, #{binding.categoryId}, #{binding.brandId},
            #{binding.createdBy}, #{binding.createdAt},
            #{binding.updatedBy}, #{binding.updatedAt}, #{binding.deleted}
            )
        </foreach>
    </insert>

    <!-- ========== 批量查询未删除的品牌 ========== -->
    <select id="selectByIdsAndDeleted" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM product_brand
        WHERE deleted = #{deleted}
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
